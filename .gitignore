# Dependencies
node_modules/
.pnpm-store/

# Next.js
.next/
out/
build/
next-env.d.ts

# Rust / Soroban
target/
**/*.rs.bk

# Environment files — never commit real secrets.
# .env.example is the only environment file that belongs in git.
.env
.env.*
!.env.example

# Stellar CLI local state
.stellar/

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Logs & debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build metadata
*.tsbuildinfo
/coverage/

# Deployment
.vercel/

# Third-party development skills copied from kaankacar/stellar-build.
# That repository publishes no license, so the files are not redistributed here.
# docs/stellar-skills.md records exactly which folders to copy and from where.
/.claude/skills/

# Session handoff note for a different coding agent. Working file, not part of
# the submission.
/CODEX_HANDOFF.md

# Generated TypeScript bindings build output. The package is regenerated by
# scripts/deploy-testnet.sh and rebuilt by `pnpm bindings:build`, which both
# `pnpm verify` and `pnpm win:verify` run.
/packages/*/dist/

# Working agent prompts. Session notes, not part of the submission.
/docs/design-upgrade-prompt.md
