# ShowUp — environment template.
# Copy to .env.local and fill in. NEVER commit a real .env file.
# Every value below targets Stellar Testnet. Mainnet is explicitly out of scope.

# --- Stellar network ---------------------------------------------------------
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# --- ShowUp contract ---------------------------------------------------------
# Current C4 Testnet deployment. Format: C...
NEXT_PUBLIC_SHOWUP_CONTRACT_ID=CCCDFM2MGKO5PEBS565O7FO2OL4CZYUFFRTQLUPPIIIL2JNCPUSUIRHM

# --- Mock Anchor (hackathon Testnet simulation) ------------------------------
# This is a simulation. It moves no real money and performs no real KYC.
NEXT_PUBLIC_ANCHOR_HOME_DOMAIN=tr-mock-anchor.fly.dev
NEXT_PUBLIC_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
NEXT_PUBLIC_USDC_CODE=USDC

# --- Settlement destinations -------------------------------------------------
# Team-controlled Testnet public key that receives the community-pool share
# of a no-show settlement. Format: G...
# `./scripts/setup-identities.sh --fund` creates this account and prints the value.
NEXT_PUBLIC_COMMUNITY_POOL_ADDRESS=GDCXH26TJFRMADSZKVLNB4EWNV2ORZHNEGDMH3D5UHPX25EW5REJOKP7

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Must never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Check-in QR -------------------------------------------------------------
# Server-side secret used to sign short-lived check-in nonces.
CHECKIN_NONCE_SECRET=

# --- Demo tooling ------------------------------------------------------------
# Enables the demo-only helpers used during the hackathon presentation.
# Must be false anywhere outside the Testnet demo.
ENABLE_DEMO_TOOLS=false

# --- Deploy identity (local tooling only) ------------------------------------
# Names of the Stellar CLI identities used by the scripts in scripts/.
# The secret keys live in the Stellar CLI keystore, never in this file.
# Note: Windows and WSL keep separate keystores, so create the identities in the
# same environment that runs the deploy. See docs/contract.md.
STELLAR_DEPLOY_IDENTITY=showup-deployer
STELLAR_COMMUNITY_POOL_IDENTITY=showup-community-pool
