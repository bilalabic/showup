# ShowUp — environment template.
# Copy to .env.local and fill in. NEVER commit a real .env file.
# Every value below targets Stellar Testnet. Mainnet is explicitly out of scope.

# --- Stellar network ---------------------------------------------------------
# These two are read by the app; both have Testnet defaults, so overriding them
# is only needed to point at a different RPC or Horizon instance.
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Public Reown/WalletConnect project identifier used to hand mobile browsers
# off to Freighter Mobile. Create one at https://cloud.reown.com and allow the
# deployed ShowUp origin. This is a public client identifier, not a secret.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- ShowUp contract ----------------------------------------------------------
# NOT read by the app. The contract id and network passphrase are baked into the
# generated bindings (packages/showup-bond-client, networks.testnet) by
# scripts/deploy-testnet.sh, and lib/contract asserts they match Testnet at load.
# Recorded here so the current deployment is visible in one place.
#   contract:  CCCDFM2MGKO5PEBS565O7FO2OL4CZYUFFRTQLUPPIIIL2JNCPUSUIRHM
#   evidence:  docs/deployments/testnet.md

# --- Mock Anchor (hackathon Testnet simulation) ------------------------------
# This is a simulation. It moves no real money and performs no real KYC.
NEXT_PUBLIC_ANCHOR_HOME_DOMAIN=tr-mock-anchor.fly.dev
NEXT_PUBLIC_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
NEXT_PUBLIC_USDC_CODE=USDC
# Enables the visibly labelled Mock-Anchor bank-transfer simulation control.
# This is a public UI feature flag, not a security boundary.
# Must be false anywhere outside the Testnet demo.
NEXT_PUBLIC_ENABLE_DEMO_TOOLS=false

# --- Settlement destinations --------------------------------------------------
# NOT read by the app. The community pool is pinned in the contract at deploy
# time, so the app reads it from get_config() rather than from the environment.
# `./scripts/setup-identities.sh --fund` creates the account and prints the value.
#   community pool: GDCXH26TJFRMADSZKVLNB4EWNV2ORZHNEGDMH3D5UHPX25EW5REJOKP7

# --- Deploy identity (local tooling only) ------------------------------------
# Names of the Stellar CLI identities used by the scripts in scripts/.
# The secret keys live in the Stellar CLI keystore, never in this file.
# Note: Windows and WSL keep separate keystores, so create the identities in the
# same environment that runs the deploy. See docs/contract.md.
STELLAR_DEPLOY_IDENTITY=showup-deployer
STELLAR_COMMUNITY_POOL_IDENTITY=showup-community-pool
